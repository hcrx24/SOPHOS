# ─────────────────────────────────────────────────────────────
#  sophos_server/.env
#  SOPHOS SSE — Server configuration
#
#  Edit these values before running run_server.sh
# ─────────────────────────────────────────────────────────────

# Hostname / DNS name of this server machine.
# Must match the CN / SAN in the server TLS certificate.
# Run:  bash gen_certs.sh $SOPHOS_HOST
SOPHOS_HOST=sophosserver

# gRPC listening port
SOPHOS_PORT=50051

# LMDB database directory (relative to sophos_server/)
SOPHOS_DB=server.db

# Directory containing ca.crt, server.key, server.crt
# (relative to sophos_server/)
SOPHOS_CERTS=../certs

# LMDB max virtual map size in GiB (not pre-allocated on disk)
SOPHOS_MAP_SIZE_GB=1

# gRPC max message size in MiB (increase for very large documents)
SOPHOS_MAX_MSG_MB=64

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
