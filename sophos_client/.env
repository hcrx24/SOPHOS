# ─────────────────────────────────────────────────────────────
#  sophos_client/.env
#  SOPHOS SSE — Client configuration
#
#  Edit these values before running run_client.sh
# ─────────────────────────────────────────────────────────────

# Server hostname or IP to connect to.
# Must match SOPHOS_HOST in sophos_server/.env (and the server certificate SAN).
SOPHOS_SERVER_HOST=sophosserver

# gRPC server port
SOPHOS_SERVER_PORT=50051

# Directory containing ca.crt, client.key, client.crt
# (relative to sophos_client/)
SOPHOS_CERTS=../certs

# Directory containing master.key, rsa_private.pem, rsa_public.pem
# (relative to sophos_client/)
SOPHOS_KEYS_DIR=keys

# SQLite state database path (relative to sophos_client/)
SOPHOS_STATE_DB=client.db

# Sample text files directory (relative to sophos_client/)
SOPHOS_SAMPLE_DIR=../sample_docs

# Downloaded files directory (relative to sophos_client/)
SOPHOS_DOWNLOAD_DIR=../downloads

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
